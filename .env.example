# Azure Speech API (Fast Nigerian voices, ~3s generation)
# Get your key at: https://portal.azure.com -> Cognitive Services -> Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# YarnGPT.ai API Key (Native Nigerian voices, ~30s generation)
# Get your key at: https://yarngpt.ai/api-docs
YARNGPT_API_KEY=your_yarngpt_api_key_here

# Deepgram API Key (Transcription for Subtitle tab + Explainer tab)
# Get your key at: https://console.deepgram.com
DEEPGRAM_VTT_KEY=your_deepgram_api_key_here

# Gemini API Key (Script generator in Explainer tab)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# api.video API Key (Cloud transcoding fallback for iOS/Firefox export)
# Get your key at: https://dashboard.api.video
APIVIDEO_API_KEY=your_apivideo_api_key_here
